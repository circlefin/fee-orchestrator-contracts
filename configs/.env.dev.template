# set -o allexport && source configs/.env.dev && set +o allexport

BLOCKCHAIN_RPC_URL=

DEPLOYER_PRIVATE_KEY=

# Address of the pre-deployed Create3Factory on the target chain.
# Deploy via: forge script script/deploy/DeployCreate3Factory.s.sol ...
CREATE3_FACTORY_ADDRESS=

# Per-contract CREATE3 salts. Proxy salts are stable across impl upgrades;
# use the same proxy salt across chains for identical proxy addresses.
# Bump the implementation salt when deploying a new impl (avoids CREATE3 collision).
FEE_MANAGER_PROXY_SALT=fee-manager-proxy-v1
FEE_MANAGER_IMPLEMENTATION_SALT=fee-manager-impl-v1
TOKEN_MESSENGER_WITH_FEES_PROXY_SALT=tmwf-proxy-v1
TOKEN_MESSENGER_WITH_FEES_IMPLEMENTATION_SALT=tmwf-impl-v1

# Address of the existing TokenMessengerV2 contract on the target chain.
# Required for TokenMessengerWithFees deployment.
TOKEN_MESSENGER_V2_ADDRESS=

# Address of the deployed FeeTaker proxy on the target chain.
# Passed as an immutable constructor arg to FeeManager implementation.
FEE_TAKER_ADDRESS=

# USDC token contract on the target chain (must match FeeTaker’s configured USDC).
# Passed as an immutable constructor arg to FeeManager implementation.
USDC_ADDRESS=

# Deployed FeeManager UUPS proxy (from DeployFeeManager logs). Used by test scripts and verification.
FEE_MANAGER_PROXY_ADDRESS=

# TokenMessengerWithFees proxy — required for UpgradeTokenMessengerWithFees.s.sol `run` / `upgradeProxyOnly`.
# TOKEN_MESSENGER_WITH_FEES_PROXY_ADDRESS=

# Set only when using `upgradeProxyOnly()` after deploying an implementation elsewhere.
# FEE_MANAGER_IMPLEMENTATION_ADDRESS=
# TOKEN_MESSENGER_WITH_FEES_IMPLEMENTATION_ADDRESS=

# Optional: FeeManager role holders and initial signer (see DeployFeeManager.s.sol).
# FEE_MANAGER_CALLER_ADMIN=   # if set and non-zero, granted at deploy; else owner grants later
# FEE_MANAGER_SIGNER_ADMIN=   # if set and non-zero, granted at deploy; else owner grants later
# FEE_MANAGER_TRUSTED_SIGNER=
# FEE_MANAGER_PAUSER=

# Optional: required for --verify on testnet/mainnet deploys.
# ETHERSCAN_API_KEY=
